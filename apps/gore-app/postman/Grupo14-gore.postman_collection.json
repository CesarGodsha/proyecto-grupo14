        },
        {
          "name": "Eliminar expediente GORE de prueba (200)",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{moduleBaseUrl}}/gore/{{goreId}}",
              "host": [
                "{{moduleBaseUrl}}"
              ],
              "path": [
                "gore",
                "{{goreId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Administrador elimina el expediente creado por la prueba', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
