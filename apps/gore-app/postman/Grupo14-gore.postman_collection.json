{
  "info": {
    "_postman_id": "486c4269-676e-48f9-95d2-4ce6ce9c35a8",
    "name": "Grupo 14 - gore",
    "description": "Coleccion Postman independiente para gore. Inicia sesion primero; el token se guarda en el entorno.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{authToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01 - Autenticación",
      "item": [
        {
          "name": "Login correcto (200)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            },
            "url": {
              "raw": "{{authBaseUrl}}/auth/login",
              "host": [
                "{{authBaseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200 y devuelve token y usuario', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.token).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.usuario).to.have.property('roles');",
                  "  pm.environment.set('authToken', body.token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login con clave incorrecta (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"clave-incorrecta\"\n}"
            },
            "url": {
              "raw": "{{authBaseUrl}}/auth/login",
              "host": [
                "{{authBaseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Rechaza credenciales inválidas con 401', function () {",
                  "  pm.response.to.have.status(401);",
                  "  pm.expect(pm.response.json()).to.have.property('mensaje');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login sin datos (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{authBaseUrl}}/auth/login",
              "host": [
                "{{authBaseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Valida campos requeridos con 400', function () {",
                  "  pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - GORE",
      "item": [
        {
          "name": "Listar mis expedientes (200)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{moduleBaseUrl}}/gore",
              "host": [
                "{{moduleBaseUrl}}"
              ],
              "path": [
                "gore"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Devuelve una lista de expedientes', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Registrar expediente propio (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"asunto\": \"Prueba Postman - permiso de transporte\",\n  \"documento\": \"solicitud-postman.pdf\"\n}"
            },
            "url": {
              "raw": "{{moduleBaseUrl}}/gore",
              "host": [
                "{{moduleBaseUrl}}"
              ],
              "path": [
                "gore"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Crea el expediente con código (201)', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.codigo).to.match(/^EXP-/);",
                  "  pm.environment.set('goreId', body.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Intentar aprobar como cliente (403)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"atendido\"\n}"
            },
            "url": {
              "raw": "{{moduleBaseUrl}}/gore/{{goreId}}",
              "host": [
                "{{moduleBaseUrl}}"
              ],
              "path": [
                "gore",
                "{{goreId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Solo el personal GORE puede aprobar (403)', function () {",
                  "  pm.response.to.have.status(403);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "05 - Personal (requiere cuenta empleado)",
      "description": "Configura staffEmail y staffPassword con una cuenta que tenga rol empleado o administrador en los módulos correspondientes. Ejecuta después de las carpetas 01 a 04.",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{staffToken}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Login de personal",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{staffEmail}}\",\n  \"password\": \"{{staffPassword}}\"\n}"
            },
            "url": {
              "raw": "{{authBaseUrl}}/auth/login",
              "host": [
                "{{authBaseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Inicia sesión la cuenta de personal', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.environment.set('staffToken', pm.response.json().token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Bandeja GORE (200)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{moduleBaseUrl}}/gore",
              "host": [
                "{{moduleBaseUrl}}"
              ],
              "path": [
                "gore"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Personal GORE puede consultar la bandeja', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Atender expediente GORE (200)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"atendido\"\n}"
            },
            "url": {
              "raw": "{{moduleBaseUrl}}/gore/{{goreId}}",
              "host": [
                "{{moduleBaseUrl}}"
              ],
              "path": [
                "gore",
                "{{goreId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Empleado puede actualizar un expediente GORE', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().estado).to.eql('atendido');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "06 - Administración (requiere cuenta administrador)",
      "description": "Configura adminEmail y adminPassword con una cuenta administradora. Elimina solo los registros creados durante esta colección.",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{adminToken}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Login de administrador",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{authBaseUrl}}/auth/login",
              "host": [
                "{{authBaseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
