            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{staffEmail}}\",\n  \"password\": \"{{staffPassword}}\"\n}"
            },
            "url": {
              "raw": "{{authBaseUrl}}/auth/login",
              "host": [
                "{{authBaseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Inicia sesión la cuenta de personal', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.environment.set('staffToken', pm.response.json().token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Bandeja Logística (200)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{moduleBaseUrl}}/logistica/cotizaciones",
              "host": [
                "{{moduleBaseUrl}}"
              ],
              "path": [
                "logistica",
                "cotizaciones"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Personal de logística consulta la bandeja', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Cambiar estado de cotización (200)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"en_transito\"\n}"
            },
            "url": {
              "raw": "{{moduleBaseUrl}}/logistica/cotizaciones/{{cotizacionId}}/estado",
              "host": [
                "{{moduleBaseUrl}}"
              ],
              "path": [
                "logistica",
                "cotizaciones",
                "{{cotizacionId}}",
                "estado"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Personal puede cambiar el estado de la cotización', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "06 - Administración (requiere cuenta administrador)",
      "description": "Configura adminEmail y adminPassword con una cuenta administradora. Elimina solo los registros creados durante esta colección.",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{adminToken}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Login de administrador",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{authBaseUrl}}/auth/login",
              "host": [
                "{{authBaseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Inicia sesión la cuenta administradora', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.environment.set('adminToken', pm.response.json().token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Eliminar cotización de prueba (200)",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{moduleBaseUrl}}/logistica/cotizaciones/{{cotizacionId}}",
              "host": [
                "{{moduleBaseUrl}}"
              ],
              "path": [
                "logistica",
                "cotizaciones",
                "{{cotizacionId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Administrador elimina la cotización creada por la prueba', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
