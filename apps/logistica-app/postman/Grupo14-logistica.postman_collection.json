{
  "info": {
    "_postman_id": "1f347fd6-00d7-42d5-acec-7f0c16ac9980",
    "name": "Grupo 14 - logistica",
    "description": "Coleccion Postman independiente para logistica. Inicia sesion primero; el token se guarda en el entorno.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{authToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01 - Autenticación",
      "item": [
        {
          "name": "Login correcto (200)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            },
            "url": {
              "raw": "{{authBaseUrl}}/auth/login",
              "host": [
                "{{authBaseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200 y devuelve token y usuario', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.token).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.usuario).to.have.property('roles');",
                  "  pm.environment.set('authToken', body.token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login con clave incorrecta (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"clave-incorrecta\"\n}"
            },
            "url": {
              "raw": "{{authBaseUrl}}/auth/login",
              "host": [
                "{{authBaseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Rechaza credenciales inválidas con 401', function () {",
                  "  pm.response.to.have.status(401);",
                  "  pm.expect(pm.response.json()).to.have.property('mensaje');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login sin datos (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{authBaseUrl}}/auth/login",
              "host": [
                "{{authBaseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Valida campos requeridos con 400', function () {",
                  "  pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 - Logística",
      "item": [
        {
          "name": "Listar todas como cliente (403)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{moduleBaseUrl}}/logistica/cotizaciones",
              "host": [
                "{{moduleBaseUrl}}"
              ],
              "path": [
                "logistica",
                "cotizaciones"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('La lista general requiere rol de empleado o administrador (403)', function () {",
                  "  pm.response.to.have.status(403);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear cotización propia (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ruta\": \"Huancayo - Callao\",\n  \"carga\": \"Carga de prueba\",\n  \"toneladas\": 5,\n  \"matpel\": false\n}"
            },
            "url": {
              "raw": "{{moduleBaseUrl}}/logistica/cotizaciones",
              "host": [
                "{{moduleBaseUrl}}"
              ],
              "path": [
                "logistica",
                "cotizaciones"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Crea cotización y devuelve código y tarifa (201)', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.codigo).to.match(/^COT-/);",
                  "  pm.expect(body.monto_calculado).to.eql(450);",
                  "  pm.environment.set('cotizacionId', body.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar mis cotizaciones (200)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{moduleBaseUrl}}/logistica/cotizaciones/mias",
              "host": [
                "{{moduleBaseUrl}}"
              ],
              "path": [
                "logistica",
                "cotizaciones",
                "mias"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Devuelve una lista de mis cotizaciones (200)', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Actualizar cotización propia (200)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ruta\": \"Huancayo - Callao\",\n  \"carga\": \"Carga de prueba actualizada\",\n  \"toneladas\": 6,\n  \"matpel\": false\n}"
            },
            "url": {
              "raw": "{{moduleBaseUrl}}/logistica/cotizaciones/{{cotizacionId}}",
              "host": [
                "{{moduleBaseUrl}}"
              ],
              "path": [
                "logistica",
                "cotizaciones",
                "{{cotizacionId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Actualiza la cotización registrada (200)', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().monto_calculado).to.eql(530);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "05 - Personal (requiere cuenta empleado)",
      "description": "Configura staffEmail y staffPassword con una cuenta que tenga rol empleado o administrador en los módulos correspondientes. Ejecuta después de las carpetas 01 a 04.",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{staffToken}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Login de personal",
          "request": {
